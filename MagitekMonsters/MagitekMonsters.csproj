<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Author>Magitek Monsters Team</Author>
    <Name>Magitek Monsters</Name>
    <AssemblyName>MagitekMonsters</AssemblyName>
    <RootNamespace>MagitekMonsters</RootNamespace>
    <Punchline>A server-backed monster-catching companion game inside FFXIV.</Punchline>
    <Description>Catch, train, store, and battle Pokémon through an ImGui companion window. Valuable game state and Pokémon Showdown battles are authoritative on your Magitek Monsters server.</Description>
    <Tags>pokemon;companion;battle;minigame</Tags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\starter-previews.json" LogicalName="MagitekMonsters.StarterPreviews.json" />
    <EmbeddedResource Include="Data\species-display.json" LogicalName="MagitekMonsters.SpeciesDisplay.json" />
    <ProjectReference Include="..\Contracts\MagitekMonsters.Contracts.csproj" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Graphics\types\**\*.png">
      <Link>Graphics\types\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\icon.png">
      <Link>images\icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Graphics\items\**\*.png">
      <Link>Graphics\items\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\Graphics\pokemon\*.png">
      <Link>Graphics\pokemon\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\Graphics\pokemon\shiny\*.png">
      <Link>Graphics\pokemon\shiny\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\Graphics\overrides\items\*.png">
      <Link>Graphics\overrides\items\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\Graphics\licenses\*.txt">
      <Link>Graphics\licenses\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\Graphics\asset-manifest.json">
      <Link>Graphics\asset-manifest.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
